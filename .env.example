# ---------- PostgreSQL (contenedor "basedatos") ----------
POSTGRES_USER=reservalab
POSTGRES_PASSWORD=reservalab
POSTGRES_DB=reservalab

# ---------- API (desarrollo local; docker-compose cambia los hosts) ----------
PUERTO_API=3000
URL_BASE_DATOS=postgresql://reservalab:reservalab@localhost:5432/reservalab
URL_REDIS=redis://localhost:6379
URL_NOTIFICACIONES=http://localhost:3001
SECRETO_JWT=cambia-esto-por-un-texto-largo-y-aleatorio
DURACION_TOKEN_ACCESO=15m
DIAS_TOKEN_REFRESCO=7
TTL_CACHE_SEGUNDOS=60
LIMITE_SOLICITUDES_POR_MINUTO=60
ORIGEN_WEB=http://localhost:5173

# ---------- Web (Vite solo expone variables que empiezan con VITE_) ----------
VITE_URL_API=http://localhost:3000/api/v1
VITE_LLAVE_API_PANTALLA=rl_live_pantalla_demo_0123456789abcdef

# ---------- CLI ----------
URL_API=http://localhost:3000/api/v1
