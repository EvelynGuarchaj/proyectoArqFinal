{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/servidor.ts",
    "start": "tsx src/servidor.ts",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run --coverage",
    "bd:migrar": "dotenv -e ../../.env -- prisma migrate dev",
    "bd:semilla": "dotenv -e ../../.env -- prisma db seed",
    "bd:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/semilla.ts"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "@reservalab/shared": "workspace:^",
    "bcryptjs": "^3",
    "cors": "^2.8.6",
    "express": "^5",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
